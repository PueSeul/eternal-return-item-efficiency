{
  "name": "er-damage-efficiency",
  "version": "1.7.5",
  "private": true,
  "description": "이터널 리턴 아이템 가격 대비 데미지 효율 계산기",
  "main": "electron/main.js",
  "scripts": {
    "start": "node server.js",
    "test": "node --test",
    "app": "electron .",
    "build:exe": "node electron/build.js",
    "build:exe:v1": "node electron/build.js --v1"
  },
  "build": {
    "appId": "local.er-damage-efficiency",
    "productName": "ER-Damage-Calculator",
    "files": [
      "index.html",
      "src/**/*",
      "data/**/*",
      "scripts/**/*.mjs",
      "!scripts/**/*.test.mjs",
      "electron/**/*",
      "!electron/**/*.test.js",
      "!electron/build.js",
      "package.json",
      "build/icon.ico"
    ],
    "win": {
      "target": "portable",
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.exe"
    }
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "electron": "^44.8.0",
    "electron-builder": "^26.15.3",
    "sharp": "^0.35.5"
  }
}
